# SLA Guardian AI — Backend Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.

# Database
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/sla_guardian
# For SQLite (local standalone testing): sqlite:///./sla_guardian.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sla_guardian

# Google Gemini AI API Configuration
# Optional: If unset or invalid, the system automatically uses intelligent deterministic templates
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Machine Learning Artifacts Path
MODEL_PATH=./app/ml/artifacts

# Application Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# Operational SLA & Escalation Parameters
DEFAULT_PRE_BREACH_BUFFER_MINUTES=20
SLA_BREACH_RISK_THRESHOLD=0.75
CRITICAL_RISK_THRESHOLD=0.80
HIGH_RISK_THRESHOLD=0.65
MEDIUM_RISK_THRESHOLD=0.40
